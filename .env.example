# Учётные данные Timepad для режима «Проход на мероприятие».
# Скопируйте в .env.local (он в .gitignore) и заполните своими значениями.
# Переменные с префиксом VITE_ попадают в клиентский бандл — не коммитьте .env.local.

# OAuth2 access token организатора (Authorization: Bearer <token>)
VITE_TIMEPAD_TOKEN=
# client_id приложения Timepad
VITE_TIMEPAD_CLIENT_ID=
# id события, участников которого контролируем на входе
VITE_TIMEPAD_EVENT_ID=
